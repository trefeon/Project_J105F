# Third-party reference material (cloned repos, ~6.4 GB, re-clonable upstream)
# See docs/research/J105F-CustomOS-Research.md for the inventory + origins
reference/

# Downloaded tool binaries (Google platform-tools = adb/fastboot)
tools/platform-tools/

# Raw device partition images — PRIVATE (EFS contains device identifiers,
# modem is proprietary firmware). Kept local + on the phone's microSD only.
device/evidence/stock-backup/*.img
device/evidence/stock-backup/*.zImage
device/evidence/stock-backup/*.cpio.gz

# Downloaded CI build artifacts (reproducible via GitHub Actions)
device/evidence/build-artifacts/

# Separate repo workspace (custom TWRP tree lives in its own GitHub repo)
twrp/

# Common junk
out/
build/
*.log
.DS_Store
Thumbs.db
